{
  "id": "dc3a-hotkernel-formal",
  "name": "DC3A HotKernel 正式参考库",
  "type": "benchmark",
  "mode": "Any",
  "cwd": ".",
  "python": "logs/m1-pre1-cuda/Scripts/python.exe",
  "output": "logs/inf1/jobs/dc3a-hotkernel-formal",
  "max_retries": 0,
  "budget_seconds": 21600,
  "stop_grace_seconds": 240,
  "limits": {
    "reference_worlds": 192,
    "confirmation_evaluations": 0
  },
  "inputs": [
    "experiments/m1-dc3a/reference.py",
    "experiments/m1-dc1/dc_common.py",
    "experiments/m1-sv4a/loop_battle.py",
    "experiments/m1-sv4a/loop_common.py",
    "experiments/m1-dc1/config.json",
    "logs/m1-sv4a-host/build.json",
    "logs/m1-pre0b-host-final/build.json",
    "logs/m1-dc1-formal/roots/development.json",
    "logs/m1-dc2b-frozen/development.json",
    "logs/m1-dc3a-frozen/formal.json",
    "logs/inf1/jobs/dc3a-hotkernel-pilot/solve/budget.json",
    "experiments/hk1a/reference.py",
    "experiments/hk1a/hk1a_build.py",
    "experiments/hk1a/Oracle.cs",
    "experiments/m1-s1/SyntheticCombat.cs",
    "logs/hk1a-build/build.json"
  ],
  "stages": [
    {
      "id": "solve",
      "depends_on": [],
      "args": [
        "experiments/hk1a/reference.py",
        "{work}",
        "--manifest",
        "{repo}/logs/m1-dc3a-frozen/formal.json",
        "--budget-file",
        "{repo}/logs/inf1/jobs/dc3a-hotkernel-pilot/solve/budget.json"
      ],
      "gpu": false,
      "heavy": true,
      "workers": 1,
      "resume": "checkpoint",
      "boundary": "One committed combat world"
    }
  ]
}

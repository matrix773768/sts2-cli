{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SyntheticCombatSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "character", "ascension", "encounter", "seed", "deck", "hp", "max_hp", "relics", "potions"],
  "properties": {
    "schema": {"const": 1},
    "character": {"type": "string", "pattern": "^(Ironclad|Silent|Defect|Regent|Necrobinder)$"},
    "ascension": {"type": "integer", "minimum": 0, "maximum": 10},
    "encounter": {"$ref": "#/$defs/NativeId"},
    "seed": {"type": "string", "pattern": "\\S"},
    "deck": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "upgrade"],
        "properties": {
          "id": {"$ref": "#/$defs/NativeId"},
          "upgrade": {"enum": [0, 1]}
        }
      }
    },
    "hp": {"type": "integer", "minimum": 1, "maximum": 999},
    "max_hp": {"type": "integer", "minimum": 1, "maximum": 999},
    "relics": {"type": "array", "uniqueItems": true, "items": {"const": "BURNING_BLOOD"}},
    "potions": {"type": "array", "items": {"enum": [null, "FLEX_POTION"]}}
  },
  "$defs": {
    "NativeId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
  }
}
